{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dev-workflow/schemas/stack.schema.json",
  "title": "Stack",
  "description": "Schema for .claude/stack.yaml — project stack, gates, paths and promotion config.",
  "type": "object",
  "required": ["stack", "team_preset", "gates"],
  "additionalProperties": false,
  "properties": {
    "stack": {
      "type": "object",
      "required": ["name", "language"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "language": { "type": "string" },
        "runtime": { "type": "string" }
      }
    },
    "team_preset": {
      "type": "string",
      "enum": ["solo", "small-team", "oss", "enterprise"]
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prd": { "type": "string", "default": "PRD.md" },
        "context": { "type": "string", "default": "CONTEXT.md" },
        "epics": { "type": "string", "default": "docs/planning/epics.yaml" },
        "epic_tasks_glob": { "type": "string", "default": "docs/planning/epic-*-tasks.yaml" },
        "scenarios_index": { "type": "string", "default": "docs/planning/SCENARIOS.md" },
        "ruleset": { "type": "string", "default": ".claude/ruleset/" },
        "runs": { "type": "string", "default": ".claude/runs/" },
        "runs_archive": { "type": "string", "default": ".claude/runs-archive/" },
        "adr": { "type": "string", "default": "docs/adr/" }
      }
    },
    "gates": {
      "type": "object",
      "properties": {
        "_timeout_seconds": { "type": "integer", "minimum": 1, "default": 600 },
        "lint": { "type": ["string", "null"] },
        "typecheck": { "type": ["string", "null"] },
        "domain_tests": { "type": ["string", "null"] },
        "atdd_specs": { "type": ["string", "null"] },
        "journeys": { "type": ["string", "null"] },
        "build": { "type": ["string", "null"] },
        "security": { "type": ["string", "null"] },
        "a11y": { "type": ["string", "null"] },
        "perf": { "type": ["string", "null"] },
        "monitoring": { "type": ["string", "null"] }
      },
      "additionalProperties": { "type": ["string", "null"] }
    },
    "design_verify": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "enum": ["script", "prompt"] },
        "path": { "type": "string" }
      }
    },
    "promote": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "environments": {
          "type": "array",
          "items": { "type": "string" }
        },
        "staging_workflow": { "type": ["string", "null"] },
        "prod_workflow": { "type": ["string", "null"] },
        "pre_flight": { "type": ["string", "null"] }
      }
    },
    "extras": {
      "type": "object",
      "description": "Escape hatch for stack-specific quirks. Propagated verbatim to every subagent. Documented conventions (none required, all optional): `concurrent_unsafe_gates: [<gate_name>, ...]` — gates that cannot run in parallel (e.g. simulator boot, port binding, single build cache); /003-verify-dod epic mode runs them once sequentially after the parallel verifier wave and folds their findings into the terminal task's per-task artifact. `bash_buffering_warning`, `user_ping_interval_minutes`, `git_host`, `upstream_remote`, `upstream_repo` are other known consumers in /003/004/006/007. Any other keys pass through unmodified.",
      "additionalProperties": true,
      "properties": {
        "concurrent_unsafe_gates": {
          "type": "array",
          "items": { "type": "string" }
        },
        "bash_buffering_warning": { "type": "string" },
        "user_ping_interval_minutes": { "type": "integer" },
        "git_host": { "type": "string" },
        "upstream_remote": { "type": "string" },
        "upstream_repo": { "type": "string" }
      }
    }
  }
}
