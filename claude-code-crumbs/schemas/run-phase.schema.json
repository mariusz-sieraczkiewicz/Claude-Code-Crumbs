{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claude-code-crumbs/schemas/run-phase.schema.json",
  "title": "Run Phase",
  "description": "Schema for .claude/runs/{epic_id}/[<task_id>/]NN-<phase>.json — subagent output for one phase of the chain. task_id is required for all phases except plan; the plan phase may omit task_id in fresh mode and include it in resplit mode.",
  "type": "object",
  "required": ["phase", "epic_id", "agent", "status", "started_at"],
  "additionalProperties": false,
  "properties": {
    "phase": {
      "type": "string",
      "enum": ["plan", "impl", "impl-plan", "verify", "review", "feedback-impl"]
    },
    "mode": {
      "type": "string",
      "enum": ["fresh", "resplit"],
      "description": "Used by plan phase only: 'fresh' means no pre-existing task_id (planner creates tasks); 'resplit' means operating on an existing task flagged too-big."
    },
    "epic_id": {
      "type": "string",
      "pattern": "^E-\\d{3}$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^T-\\d{3}$"
    },
    "agent": {
      "type": "string",
      "enum": ["planner", "implementer", "verifier", "reviewer", "feedback-implementer"]
    },
    "status": {
      "type": "string",
      "enum": ["ok", "fail", "blocked", "too_big_proposal"]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "next": {
      "oneOf": [
        { "type": "null" },
        { "enum": ["plan", "resplit", "impl", "impl-plan", "verify", "review", "feedback-impl", "merge", "promote", "user-decision", "loop-limit"] }
      ]
    },
    "payload": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "required": ["rule", "severity", "location", "message"],
      "additionalProperties": false,
      "properties": {
        "rule": { "type": "string" },
        "severity": {
          "description": "Severity tier. Two tier systems coexist for back-compat: (1) 'blocker' is the legacy/default tier emitted by /003-verify-dod (verifier agent) — every DoD failure is a hard blocker. (2) 'Critical' | 'High' | 'Medium' | 'Low' are the /004-code-review reviewer tiers per sielappkowo convention. All 5 values are kept (none dropped); consumers should treat 'blocker' as equivalent to 'Critical' for halt decisions.",
          "type": "string",
          "enum": ["blocker", "Critical", "High", "Medium", "Low"]
        },
        "location": { "type": "string" },
        "message": { "type": "string" },
        "details": { "type": "string" }
      }
    },
    "tooBigSplitItem": {
      "type": "object",
      "required": ["title", "rationale"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "rationale": { "type": "string" }
      }
    },
    "criterionAuditItem": {
      "type": "object",
      "required": ["criterion_id", "criterion_text", "status"],
      "additionalProperties": false,
      "properties": {
        "criterion_id": {
          "description": "Stable identifier for the criterion within the task. Convention: 1-based index from acceptance_criteria array in epic-{id}-tasks.yaml.",
          "type": "string"
        },
        "criterion_text": {
          "description": "Verbatim criterion text from epic-{id}-tasks.yaml.",
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["satisfied", "partial", "not_satisfied"]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["file"],
            "additionalProperties": false,
            "properties": {
              "file": { "type": "string" },
              "line": { "type": "integer" },
              "snippet": { "type": "string" }
            }
          }
        },
        "rationale": {
          "description": "One-line explanation when status is partial or not_satisfied.",
          "type": "string"
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "phase": { "const": "plan" } }, "required": ["phase"] },
      "then": { "properties": { "agent": { "const": "planner" } } },
      "else": { "required": ["task_id"] }
    },
    {
      "if": { "properties": { "phase": { "const": "impl" } }, "required": ["phase"] },
      "then": { "properties": { "agent": { "const": "implementer" } } }
    },
    {
      "if": { "properties": { "phase": { "const": "impl-plan" } }, "required": ["phase"] },
      "then": { "properties": { "agent": { "const": "implementer" } } }
    },
    {
      "if": { "properties": { "phase": { "const": "verify" } }, "required": ["phase"] },
      "then": {
        "properties": {
          "agent": { "const": "verifier" },
          "payload": {
            "type": "object",
            "required": ["criteria_audit"],
            "properties": {
              "criteria_audit": {
                "type": "array",
                "items": { "$ref": "#/$defs/criterionAuditItem" }
              },
              "gates_run": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "gate": { "type": "string" },
                    "status": { "type": "string", "enum": ["ok", "fail"] }
                  }
                }
              },
              "gates_skipped": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "gate": { "type": "string" },
                    "reason": { "type": "string" }
                  }
                }
              }
            }
          }
        },
        "required": ["findings", "payload"]
      }
    },
    {
      "if": { "properties": { "phase": { "const": "review" } }, "required": ["phase"] },
      "then": {
        "properties": { "agent": { "const": "reviewer" } },
        "required": ["findings"]
      }
    },
    {
      "if": { "properties": { "phase": { "const": "feedback-impl" } }, "required": ["phase"] },
      "then": { "properties": { "agent": { "const": "feedback-implementer" } } }
    },
    {
      "if": { "properties": { "phase": { "const": "plan" } }, "required": ["phase"] },
      "then": { "properties": { "status": { "enum": ["ok", "blocked"] } } }
    },
    {
      "if": { "properties": { "phase": { "const": "impl" } }, "required": ["phase"] },
      "then": { "properties": { "status": { "enum": ["ok", "too_big_proposal", "blocked"] } } }
    },
    {
      "if": { "properties": { "phase": { "const": "impl-plan" } }, "required": ["phase"] },
      "then": { "properties": { "status": { "enum": ["ok", "too_big_proposal", "blocked"] } } }
    },
    {
      "if": { "properties": { "phase": { "const": "impl-plan" } }, "required": ["phase"] },
      "then": {
        "required": ["payload"],
        "properties": {
          "payload": {
            "type": "object",
            "required": ["iteration", "files_to_touch", "red_sketch", "green_shape", "refactor_notes"],
            "properties": {
              "iteration": { "type": "integer" },
              "files_to_touch": {
                "type": "array",
                "items": { "type": "string" }
              },
              "red_sketch": { "type": "string" },
              "green_shape": { "type": "string" },
              "refactor_notes": { "type": "string" },
              "user_feedback": { "type": "string" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "phase": { "const": "verify" } }, "required": ["phase"] },
      "then": { "properties": { "status": { "enum": ["ok", "fail"] } } }
    },
    {
      "if": { "properties": { "phase": { "const": "review" } }, "required": ["phase"] },
      "then": { "properties": { "status": { "enum": ["ok", "fail"] } } }
    },
    {
      "if": { "properties": { "phase": { "const": "feedback-impl" } }, "required": ["phase"] },
      "then": { "properties": { "status": { "enum": ["ok", "blocked"] } } }
    },
    {
      "if": {
        "properties": {
          "agent": { "const": "implementer" },
          "status": { "const": "too_big_proposal" }
        },
        "required": ["agent", "status"]
      },
      "then": {
        "required": ["payload"],
        "properties": {
          "payload": {
            "type": "object",
            "required": ["reason", "suggested_split"],
            "properties": {
              "reason": { "type": "string" },
              "suggested_split": {
                "type": "array",
                "minItems": 2,
                "items": { "$ref": "#/$defs/tooBigSplitItem" }
              }
            }
          }
        }
      }
    }
  ]
}
